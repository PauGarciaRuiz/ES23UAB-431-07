@startuml
actor Comprador
boundary "Interfície Comanda"
control "Gestor Comanda"
entity Comanda
entity Plat

' --- AFEGIR PLAT ---
Comprador -> "Interfície Comanda" : AfegirPlat()
activate "Interfície Comanda"

"Interfície Comanda" -> "Gestor Comanda" : AfegirPlat()
activate "Gestor Comanda"

"Gestor Comanda" -> Plat : BuscarPlat()
activate Plat
Plat --> "Gestor Comanda" : return()
deactivate Plat

"Gestor Comanda" -> Comanda : AfegirCarret()
activate Comanda
Comanda --> "Gestor Comanda" : return()
deactivate Comanda

' --- ACCEDIR CARRET ---
Comprador -> "Interfície Comanda" : AccedirCarret()

"Interfície Comanda" -> "Gestor Comanda" : AccedirCarret()

"Gestor Comanda" -> Comanda : BuscarCarret()
activate Comanda
Comanda --> "Gestor Comanda" : return()
deactivate Comanda

"Gestor Comanda" --> "Interfície Comanda" : MostrarCarret()

' --- DEMANAR MODIFICAR INGREDIENTS ---
Comprador -> "Interfície Comanda" : DemanarModificarIngredients()

"Interfície Comanda" -> "Gestor Comanda" : ObtenirIngredientsOpcionals()

"Gestor Comanda" -> Plat : ObtenirIngredients()
activate Plat

' --- A2: ERROR INGREDIENTS vs CONTINUAR ---
alt A2 (Si el Plat no té ingredients opcionals)
    Plat --> "Gestor Comanda" : llistaBuida
    "Gestor Comanda" --> "Interfície Comanda" : Error_NO_Ing()
else (Té ingredients opcionals)
    Plat --> "Gestor Comanda" : llistaIngredients
    deactivate Plat
    
    "Gestor Comanda" --> "Interfície Comanda" : MostrarIngredients()
    
    ' --- A1: CANCEL·LACIÓ vs MODIFICACIÓ ---
    alt A1 (Si client surt)
        Comprador -> "Interfície Comanda" : Sortir()
    else (Client confirma modificació)
        Comprador -> "Interfície Comanda" : ModIngred(nousIngredients)
        
        "Interfície Comanda" -> "Gestor Comanda" : ModIngred(nousIngredients)
        
        "Gestor Comanda" -> Comanda : ModificarIngredientsPlat()
        activate Comanda
        Comanda --> "Gestor Comanda" : return()
        deactivate Comanda
        
        "Gestor Comanda" --> "Interfície Comanda" : MostrarCarretActualitzat()
    end
end

deactivate "Gestor Comanda"
deactivate "Interfície Comanda"

@enduml
